DATABASE_URL="postgresql://appdaovang:appdaovang@localhost:5433/appdaovang"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# AI Trader (chuẩn OpenAI-compatible)
# Ollama (miễn phí, chạy local): AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=llama3.1, AI_API_KEY=ollama
# OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini, AI_API_KEY=sk-...
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=ollama

# Báo lệnh qua Telegram (tùy chọn — để trống thì tính năng tự ẩn, không lỗi)
# 1. Chat với @BotFather trên Telegram -> /newbot -> đặt tên -> lấy TOKEN và USERNAME (không có @)
# 2. Dán vào 2 biến dưới đây rồi khởi động lại server
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Nến giá spot thật cho AI Setup lệnh (khuyến nghị — Yahoo XAUUSD=X đã ngừng hoạt động, để trống
# sẽ tự rơi về futures GC=F kém chính xác hơn một chút)
# 1. Đăng ký free tại https://twelvedata.com (chỉ cần email, không cần thẻ)
# 2. Vào Dashboard -> copy API Key
TWELVEDATA_API_KEY=
